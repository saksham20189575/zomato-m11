# Hugging Face dataset (or override with a local path later)
DATASET_NAME=ManikaSaini/zomato-restaurant-recommendation
CACHE_DIR=data

# Groq LLM (OpenAI-compatible) — https://console.groq.com/keys
# Either LLM_API_KEY or GROQ_API_KEY works.
LLM_API_KEY=
# GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Recommendation tuning
MAX_CANDIDATES=20
DEFAULT_TOP_K=5

# Fallback cost-band cutoffs (used only if dataset percentiles collapse)
BUDGET_LOW_MAX=300
BUDGET_MEDIUM_MAX=550

# FastAPI CORS (comma-separated). Add the Vercel production URL when deploying.
# No trailing slash — browsers send Origin without a path.
# Example: http://localhost:3000,http://127.0.0.1:3000,https://zomato-m11.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
