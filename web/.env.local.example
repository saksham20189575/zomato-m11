# FastAPI base URL for Next.js rewrites (`/backend/*` → this URL).
# The browser calls `/backend/...` same-origin; this env is the rewrite target.
# Local: http://127.0.0.1:8000
# Use 127.0.0.1, not localhost — Node prefers IPv6 (::1) and uvicorn
# listens on IPv4 only, which makes the /backend rewrite return 502.
# Production (Vercel): https://<your-railway-service>.up.railway.app  (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
